generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local development schema. Used by `prisma generate`, `db push`, seed, and `next dev`.
  // Keep provider = "sqlite" in git. Production Postgres lives in prisma/postgres/.
  // On Vercel, scripts/prepare-prisma.mjs rewrites this provider to postgresql for the build.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  NEGOTIATION
  WON
  LOST
  DORMANT
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum IntentType {
  BUYING
  RENTING
  UNKNOWN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  WHATSAPP
  EMAIL
  SMS
  SYSTEM
}

enum FollowUpType {
  NEW_LEAD_RESPONSE
  NO_RESPONSE
  DUE_REMINDER
  DORMANT_REACTIVATION
  AGENT_ALERT
}

enum FollowUpStatus {
  PENDING
  PROCESSING
  SENT
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  PAUSED
  SENT
  COMPLETED
}

enum CampaignRecipientStatus {
  PENDING
  APPROVED
  SENT
  RESPONDED
  FAILED
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_INACTIVE
  FOLLOW_UP_DUE
  LEAD_BECOMES_HOT
  NO_RESPONSE
}

enum AutomationActionType {
  SEND_WHATSAPP
  SEND_EMAIL
  CREATE_TASK
  NOTIFY_AGENT
  CHANGE_LEAD_STATUS
  ASSIGN_AGENT
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum IntegrationType {
  WHATSAPP
  EMAIL
  WEBHOOK
  N8N
  CRM
}

enum NotificationType {
  FOLLOW_UP_DUE
  NEW_LEAD
  LEAD_REPLIED
  AGENT_ALERT
  CAMPAIGN
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  clerkId       String?   @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  assignedLeads Lead[]           @relation("AssignedAgent")
  notifications Notification[]
  auditLogs     AuditLog[]
  invitations   Invitation[]     @relation("InvitedBy")
  apiKeys       ApiKey[]
  imports       ImportHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  market               String   @default("Dubai")
  country              String   @default("UAE")
  timezone             String   @default("Asia/Dubai")
  currency             String   @default("AED")
  logoUrl              String?
  settings             String   @default("{}")
  isDemo               Boolean  @default(false)
  onboardingCompleted  Boolean  @default(false)
  widgetKey            String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships   Membership[]
  leads         Lead[]
  followUps     FollowUp[]
  automations   Automation[]
  campaigns     Campaign[]
  properties    Property[]
  notifications Notification[]
  subscription  Subscription?
  integrations  Integration[]
  revenueEvents RevenueEvent[]
  auditLogs     AuditLog[]
  invitations   Invitation[]
  agents        Agent[]
  apiKeys       ApiKey[]
  imports       ImportHistory[]
  chatSessions  ChatSession[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role
  token          String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

model Agent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  email          String
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Lead {
  id                 String          @id @default(cuid())
  organizationId     String
  name               String
  phone              String?
  email              String?
  source             String?
  propertyType       String?
  location           String?
  budgetMin          Int?
  budgetMax          Int?
  currency           String          @default("AED")
  intent             IntentType      @default(UNKNOWN)
  timeline           String?
  bedrooms           Int?
  leadScore          Int             @default(0)
  temperature        LeadTemperature @default(COLD)
  status             LeadStatus      @default(NEW)
  assignedAgentId    String?
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  notes              String?
  objections         String?
  recommendedAction  String?
  isReactivated      Boolean         @default(false)
  reactivatedAt      DateTime?
  estimatedValue     Int?
  qualificationJson  String?
  phoneNormalized    String?
  emailNormalized    String?
  intentStrength     String?
  riskScore          Int?
  revenueAtRisk      Int?
  optedOutAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAgent User?                @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages      LeadMessage[]
  followUps     FollowUp[]
  campaignRecipients CampaignRecipient[]
  revenueEvents RevenueEvent[]
  properties    Property[]
  chatSessions  ChatSession[]

  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, temperature])
  @@index([organizationId, leadScore])
  @@index([organizationId, lastContactedAt])
}

model LeadMessage {
  id             String           @id @default(cuid())
  organizationId String
  leadId         String
  direction      MessageDirection
  channel        MessageChannel   @default(WHATSAPP)
  body           String
  isAiSuggested  Boolean          @default(false)
  sentByUserId   String?
  providerId     String?
  createdAt      DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([organizationId, providerId])
}

model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  leadId         String
  type           FollowUpType
  status         FollowUpStatus @default(PENDING)
  dueAt          DateTime
  completedAt    DateTime?
  assignedToId   String?
  message        String?
  stepIndex      Int            @default(0)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([leadId, stepIndex, status])
}

model Automation {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean            @default(true)
  trigger        AutomationTrigger
  action         AutomationActionType
  config         String             @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]
}

model AutomationExecution {
  id            String   @id @default(cuid())
  automationId  String
  leadId        String?
  status        String
  result        String?
  createdAt     DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  status         CampaignStatus @default(DRAFT)
  filterDays     Int            @default(30)
  segment        String?
  createdById    String
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[]

  @@index([organizationId, status])
}

model CampaignRecipient {
  id         String                   @id @default(cuid())
  campaignId String
  leadId     String
  message    String
  status     CampaignRecipientStatus  @default(PENDING)
  sentAt     DateTime?
  respondedAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Property {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  title          String
  type           String
  location       String
  city           String?
  country        String?
  bedrooms       Int?
  bathrooms      Int?
  price          Int?
  currency       String   @default("AED")
  status         String   @default("AVAILABLE")
  description    String?
  imageUrl       String?
  externalUrl    String?
  agentName      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, location])
  @@index([organizationId, type])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  link           String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  plan               Plan               @default(STARTER)
  status             SubscriptionStatus @default(TRIALING)
  seats                    Int                @default(3)
  leadLimit                Int                @default(100)
  automationLimit          Int                @default(5)
  whatsappMonthlyLimit     Int                @default(200)
  whatsappSentThisPeriod   Int                @default(0)
  billingPeriod            String?
  currentPeriodEnd         DateTime?
  provider           String?
  providerCustomerId String?
  providerSubId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Integration {
  id             String          @id @default(cuid())
  organizationId String
  type           IntegrationType
  name           String
  enabled        Boolean         @default(false)
  config         String          @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, name])
}

model RevenueEvent {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  type           String
  amount         Int
  currency       String   @default("AED")
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String    @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, revokedAt])
}

model ImportHistory {
  id             String   @id @default(cuid())
  organizationId String
  filename       String
  source         String
  totalRows      Int      @default(0)
  imported       Int      @default(0)
  updated        Int      @default(0)
  duplicates     Int      @default(0)
  failed         Int      @default(0)
  status         String   @default("COMPLETED")
  mappingJson    String   @default("{}")
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, createdAt])
}

model ChatSession {
  id             String   @id @default(cuid())
  organizationId String
  publicId       String   @unique
  leadId         String?
  status         String   @default("ACTIVE")
  extractedJson  String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id])
  messages     ChatMessage[]

  @@index([organizationId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  body      String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}
