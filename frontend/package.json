{
  "name": "revivelead",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-prisma.mjs && next dev",
    "build": "node scripts/prepare-prisma.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prepare-prisma.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate --schema prisma/schema.prisma && prisma db push && tsx prisma/seed.ts",
    "db:prod:schema": "node scripts/sync-postgres-schema.mjs",
    "db:prod:migrate": "node scripts/sync-postgres-schema.mjs && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:prod:diff": "node scripts/sync-postgres-schema.mjs && prisma migrate diff --from-empty --to-schema-datamodel prisma/postgres/schema.prisma --script",
    "postinstall": "node scripts/prepare-prisma.mjs",
    "test": "prisma generate --schema prisma/schema.prisma && vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.6",
    "@clerk/ui": "^1.30.3",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@prisma/client": "^6.16.3",
    "@vercel/functions": "^3.9.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
